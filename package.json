{
  "name": "log-ui",
  "version": "0.1.0",
  "description": "Pipe terminal output into a rich, interactive local log viewer",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "log-ui": "bin/log-ui.mjs"
  },
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup && vite build",
    "test": "vitest run",
    "e2e": "playwright test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.17",
    "@hono/node-ws": "1.3.1",
    "commander": "^15.0.0",
    "hono": "^4.13.14",
    "open": "^11.0.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-virtual": "^3.14.22",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^5.0.5",
    "motion": "^14.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "tsup": "^9.0.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vitest": "^5.0.5",
    "zustand": "^5.0.16"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
